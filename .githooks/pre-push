#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# pre-push — full verification before code leaves the machine.
# Runs: server tests (in-memory Mongo) + client offline harness + client build.
# Bypass:  git push --no-verify      Skip everything: SKIP_PRE_PUSH=1 git push
# ─────────────────────────────────────────────────────────────
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if [ "${SKIP_PRE_PUSH:-0}" = "1" ]; then
  echo "🪝 pre-push: skipped (SKIP_PRE_PUSH=1)"
  exit 0
fi

echo "🪝 pre-push: running server tests…"
npm --prefix server test

echo "🪝 pre-push: running client offline harness…"
npm --prefix client run test:offline

echo "🪝 pre-push: building client…"
NEXT_TELEMETRY_DISABLED=1 npm --prefix client run build

echo "✅ pre-push: all checks passed"
exit 0
